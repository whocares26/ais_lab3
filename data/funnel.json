{
    "variables": {
        "доля_достижения_активации": {
            "title": "Доля достижения активации",
            "unit": "% от цели",
            "universe": { "min": 0, "max": 120, "step": 10 },
            "terms": [
                { "name": "критически_низкая", "type": "tri", "params": [-20, 0, 20] },
                { "name": "очень_низкая",      "type": "tri", "params": [0, 20, 40] },
                { "name": "низкая",            "type": "tri", "params": [20, 40, 60] },
                { "name": "ниже_цели",         "type": "tri", "params": [40, 60, 80] },
                { "name": "близко_к_цели",     "type": "tri", "params": [60, 80, 100] },
                { "name": "на_уровне_цели",    "type": "tri", "params": [80, 100, 120] },
                { "name": "выше_цели",         "type": "tri", "params": [100, 120, 140] }
            ]
        },
        "приоритет_доработки": {
            "title": "Приоритет доработки сценария",
            "unit": "баллы",
            "universe": { "min": 0, "max": 6, "step": 0.5 },
            "terms": [
                { "name": "не_требуется", "type": "tri", "params": [-1, 0, 1] },
                { "name": "минимальный",  "type": "tri", "params": [0, 1, 2] },
                { "name": "низкий",       "type": "tri", "params": [1, 2, 3] },
                { "name": "средний",      "type": "tri", "params": [2, 3, 4] },
                { "name": "повышенный",   "type": "tri", "params": [3, 4, 5] },
                { "name": "высокий",      "type": "tri", "params": [4, 5, 6] },
                { "name": "критический",  "type": "tri", "params": [5, 6, 7] }
            ]
        },
        "доля_достижения_активации_3": {
            "title": "Доля достижения активации",
            "unit": "% от цели",
            "universe": { "min": 0, "max": 120, "step": 10 },
            "terms": [
                { "name": "низкая",  "type": "trap", "params": [0, 0, 40, 70] },
                { "name": "средняя", "type": "tri",  "params": [40, 70, 100] },
                { "name": "высокая", "type": "trap", "params": [70, 100, 120, 120] }
            ]
        },
        "доля_выбывших_по_неактивности": {
            "title": "Доля выбывших по неактивности",
            "unit": "%",
            "universe": { "min": 0, "max": 100, "step": 5 },
            "terms": [
                { "name": "низкая",  "type": "trap", "params": [0, 0, 20, 40] },
                { "name": "средняя", "type": "tri",  "params": [20, 45, 70] },
                { "name": "высокая", "type": "trap", "params": [50, 70, 100, 100] }
            ]
        },
        "удержание_после_активации": {
            "title": "Удержание после активации",
            "unit": "%",
            "universe": { "min": 0, "max": 100, "step": 5 },
            "terms": [
                { "name": "низкое",  "type": "trap", "params": [0, 0, 20, 40] },
                { "name": "среднее", "type": "tri",  "params": [20, 45, 70] },
                { "name": "высокое", "type": "trap", "params": [50, 70, 100, 100] }
            ]
        }
    },
    "single_input": "доля_достижения_активации",
    "multi_inputs": [
        "доля_достижения_активации_3",
        "доля_выбывших_по_неактивности",
        "удержание_после_активации"
    ],
    "output": "приоритет_доработки",
    "single_input_rules": [
        { "id": 1, "if": [ { "var": "доля_достижения_активации", "term": "критически_низкая" } ],
                   "then": { "var": "приоритет_доработки", "term": "критический" } },
        { "id": 2, "if": [ { "var": "доля_достижения_активации", "term": "очень_низкая" } ],
                   "then": { "var": "приоритет_доработки", "term": "высокий" } },
        { "id": 3, "if": [ { "var": "доля_достижения_активации", "term": "низкая" } ],
                   "then": { "var": "приоритет_доработки", "term": "повышенный" } },
        { "id": 4, "if": [ { "var": "доля_достижения_активации", "term": "ниже_цели" } ],
                   "then": { "var": "приоритет_доработки", "term": "средний" } },
        { "id": 5, "if": [ { "var": "доля_достижения_активации", "term": "близко_к_цели" } ],
                   "then": { "var": "приоритет_доработки", "term": "низкий" } },
        { "id": 6, "if": [ { "var": "доля_достижения_активации", "term": "на_уровне_цели" } ],
                   "then": { "var": "приоритет_доработки", "term": "минимальный" } },
        { "id": 7, "if": [ { "var": "доля_достижения_активации", "term": "выше_цели" } ],
                   "then": { "var": "приоритет_доработки", "term": "не_требуется" } }
    ],
    "multi_input_rules": [
        { "id": 1, "if": [ { "var": "доля_достижения_активации_3", "term": "низкая" },
                           { "var": "доля_выбывших_по_неактивности", "term": "высокая" },
                           { "var": "удержание_после_активации", "term": "низкое" } ],
                   "then": { "var": "приоритет_доработки", "term": "критический" } },
        { "id": 2, "if": [ { "var": "доля_достижения_активации_3", "term": "низкая" },
                           { "var": "доля_выбывших_по_неактивности", "term": "высокая" },
                           { "var": "удержание_после_активации", "term": "высокое" } ],
                   "then": { "var": "приоритет_доработки", "term": "высокий" } },
        { "id": 3, "if": [ { "var": "доля_достижения_активации_3", "term": "низкая" },
                           { "var": "доля_выбывших_по_неактивности", "term": "низкая" },
                           { "var": "удержание_после_активации", "term": "низкое" } ],
                   "then": { "var": "приоритет_доработки", "term": "высокий" } },
        { "id": 4, "if": [ { "var": "доля_достижения_активации_3", "term": "низкая" },
                           { "var": "доля_выбывших_по_неактивности", "term": "низкая" },
                           { "var": "удержание_после_активации", "term": "высокое" } ],
                   "then": { "var": "приоритет_доработки", "term": "повышенный" } },
        { "id": 5, "if": [ { "var": "доля_достижения_активации_3", "term": "средняя" },
                           { "var": "доля_выбывших_по_неактивности", "term": "средняя" },
                           { "var": "удержание_после_активации", "term": "среднее" } ],
                   "then": { "var": "приоритет_доработки", "term": "средний" } },
        { "id": 6, "if": [ { "var": "доля_достижения_активации_3", "term": "высокая" },
                           { "var": "доля_выбывших_по_неактивности", "term": "средняя" },
                           { "var": "удержание_после_активации", "term": "низкое" } ],
                   "then": { "var": "приоритет_доработки", "term": "средний" } },
        { "id": 7, "if": [ { "var": "доля_достижения_активации_3", "term": "средняя" },
                           { "var": "доля_выбывших_по_неактивности", "term": "низкая" },
                           { "var": "удержание_после_активации", "term": "высокое" } ],
                   "then": { "var": "приоритет_доработки", "term": "низкий" } },
        { "id": 8, "if": [ { "var": "доля_достижения_активации_3", "term": "высокая" },
                           { "var": "доля_выбывших_по_неактивности", "term": "высокая" },
                           { "var": "удержание_после_активации", "term": "среднее" } ],
                   "then": { "var": "приоритет_доработки", "term": "низкий" } },
        { "id": 9, "if": [ { "var": "доля_достижения_активации_3", "term": "высокая" },
                           { "var": "доля_выбывших_по_неактивности", "term": "низкая" },
                           { "var": "удержание_после_активации", "term": "высокое" } ],
                   "then": { "var": "приоритет_доработки", "term": "не_требуется" } }
    ],
    "scenarios": [
        { "name": "примерно_45%_от_цели", "title": "примерно 45% от цели", "system": "single",
          "inputs": [ { "var": "доля_достижения_активации", "kind": "tri", "params": [25, 45, 65] } ] },
        { "name": "очень_низкая", "title": "очень низкая (модификатор)", "system": "single",
          "inputs": [ { "var": "доля_достижения_активации", "kind": "term", "term": "низкая", "modifier": "очень" } ] },
        { "name": "чёткий_50", "title": "ровно 50% от цели", "system": "single",
          "inputs": [ { "var": "доля_достижения_активации", "kind": "crisp", "value": 50 } ] },
        { "name": "50_60_30", "title": "активация 50%, выбывшие 60%, удержание 30%", "system": "multi",
          "inputs": [
              { "var": "доля_достижения_активации_3", "kind": "crisp", "value": 50 },
              { "var": "доля_выбывших_по_неактивности", "kind": "crisp", "value": 60 },
              { "var": "удержание_после_активации", "kind": "crisp", "value": 30 }
          ] }
    ]
}
